  Permessi dell'app nella sandbox del Mac App Store. I segnaposto TEAMID
  vengono sostituiti da store/apple/build.sh con il Team ID dell'account.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>TEAMID.net.digitare.rustinvoice</string>
  <key>com.apple.developer.team-identifier</key>
  <string>TEAMID</string>
  <!-- Fatture e cartelle scelte dall'utente, anche su dischi di rete. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- Ricordare le cartelle d'archivio tra un avvio e l'altro. -->
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <!-- Foglio di stile AssoSoftware, scaricato su richiesta. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
