{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RastInvoice",
  "version": "1.0.5",
  "identifier": "net.digitare.rustinvoice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RastInvoice",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' blob: data: about:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "app"
    ],
    "category": "Business",
    "shortDescription": "Visualizzatore di fatture elettroniche",
    "longDescription": "Visualizzatore portatile di fatture elettroniche italiane FatturaPA (fattura PA e tra privati): XML, P7M, ZIP e PEC, verifica della firma, archivio, rubrica e statistiche.",
    "copyright": "Copyright (c) 2026 Andrea Re - digitare.net",
    "publisher": "digitare.net",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "office"
      },
      "rpm": {}
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
